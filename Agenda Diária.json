    {
      "parameters": {
        "jsCode": "const eventos = $input.all();\nconst hoje = new Date().toLocaleDateString('pt-BR', { \n  day: '2-digit', \n  month: '2-digit', \n  year: 'numeric',\n  timeZone: 'America/Sao_Paulo'\n});\n\nif (eventos.length === 0) {\n  const body = {\n    number: \"YOUR_WHATSAPP_NUMBER@s.whatsapp.net\",\n    text: \"📅 Bom dia, Ruy! Você não tem eventos hoje.\"\n  };\n  return [{ json: { body: JSON.stringify(body) } }];\n}\n\nconst vistos = new Set();\nconst unicos = [];\n\nfor (const e of eventos) {\n  const inicio = new Date(e.json.start.dateTime || e.json.start.date);\n  const hora = inicio.toLocaleTimeString('pt-BR', { \n    hour: '2-digit', \n    minute: '2-digit',\n    timeZone: 'America/Sao_Paulo'\n  });\n  const titulo = e.json.summary || 'Sem título';\n  const chave = hora;\n  \n  if (!vistos.has(chave)) {\n    vistos.add(chave);\n    unicos.push({ hora, titulo });\n  }\n}\n\nunicos.sort((a, b) => a.hora.localeCompare(b.hora));\n\nlet linhas = [`📅 *Agenda de hoje — ${hoje}*`];\nfor (const e of unicos) {\n  linhas.push(`• ${e.hora} ${e.titulo}`);\n}\n\nconst body = {\n  number: \"YOUR_WHATSAPP_NUMBER@s.whatsapp.net\",\n  text: linhas.join('\\n')\n};\n\nreturn [{ json: { body: JSON.stringify(body) } }];"
      },
